# Virtual environments
.venv/
Build/*/.venv/

# Build outputs (anchored: a bare build/ also matches the Build folder on Windows)
installer/output/
Build/*/installer/output/
Build/*/installer/output-unsigned-backup/
Build/*/build/
Build/*/dist/

# Python cache
__pycache__/
*.pyc
.pytest_cache/

# User data (never commit login, sub-heads, or ledger files)
account.json
subheads.json
app.log
*.xlsx
pyinstaller.log
