<?xml version="1.0" encoding="UTF-8"?>
<!--
  Expense Ledger setup program (ExpenseLedger-Setup-1.0.0.exe).
  A single .exe that shows the license, then installs ExpenseLedger-1.0.0.msi.
  The .msi is still built on its own and can be installed directly.
  The install-scope choice ("Just me" or "Anyone who uses this computer") is the MSI's own dialog.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:bal="http://wixtoolset.org/schemas/v4/wxs/bal">
  <Bundle
    Name="Expense Ledger"
    Manufacturer="Tenwin James"
    Version="$(var.AppVersion).0"
    UpgradeCode="7A1C0E2D-5B3F-4D6A-8E9F-1A2B3C4D5E60"
    IconSourceFile="app.ico">

    <BootstrapperApplication>
      <bal:WixStandardBootstrapperApplication
        Theme="rtfLicense"
        LicenseFile="License.rtf"
        ShowVersion="yes" />
    </BootstrapperApplication>

    <Chain>
      <MsiPackage
        Id="ExpenseLedgerMsi"
        SourceFile="ExpenseLedger-$(var.AppVersion)-CurrentUser.msi"
        Compressed="yes"
        Vital="yes" />
    </Chain>
  </Bundle>
</Wix>
